# Copie ce fichier sous le nom .env, puis remplis les 3 lignes (voir README.md).
# Ne mets JAMAIS le fichier .env sur GitHub.

# Suite de 32 lettres et chiffres dans l'adresse du tableau de bord : dash.cloudflare.com/<ICI>/...
CLOUDFLARE_ACCOUNT_ID=

# Jeton : dash.cloudflare.com/profile/api-tokens > Créer un jeton > modèle « Modifier les Cloudflare Workers »
CLOUDFLARE_WORKERS_TOKEN=

# Code que chaque utilisateur tapera une fois dans l'app (au moins 6 chiffres)
CHAI_PIN=
